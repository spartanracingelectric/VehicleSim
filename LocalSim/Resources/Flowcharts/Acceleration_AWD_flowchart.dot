digraph AccelAWD {
    rankdir=TB;
    fontname="Helvetica";
    label="Acceleration_AWD.py — simulate_75m_accel()";
    labelloc="t";
    fontsize=20;
    fontcolor="#222222";
    splines=spline;
    nodesep=0.35;
    ranksep=0.35;
    bgcolor="white";

    node [fontname="Helvetica", fontsize=11, style="filled,rounded", shape=box, penwidth=1.1, color="#333333"];
    edge [fontname="Helvetica", fontsize=10, color="#333333", penwidth=1.2];

    // ---------------- INPUTS ----------------
    subgraph cluster_inputs {
        label="INPUTS";
        style="dashed"; color="#999999"; fontcolor="#777777"; fontsize=13; labeljust=l;
        car [label="car: SR_18 instance\nmass, geometry, per-axle spring/damper rates,\nmotor torque curve, Pacejka tire model,\naero coeffs, drivetrain params,\ntorque_split_front, power_limit", fillcolor="#dbe9f6"];
        params [label="target_distance = 75 m\ndt = 0.0005 s", fillcolor="#dbe9f6"];
    }

    init [label="Initialize state\nt=0, x=0, v=2.497 m/s (0.3 m rolling start)\nω_wheel, ω_motor = v/wheel_radius (all 4 wheels)\nθ_twist = 0\nsuspension states z_f, z_r = 0", fillcolor="#dbe9f6"];
    decision [label="x < 75 m ?", shape=diamond, fillcolor="#f6dbdb", fontsize=11];

    car -> init;
    params -> init;
    init -> decision;

    // ---------------- LOOP ----------------
    subgraph cluster_loop {
        label="PER-TIMESTEP PHYSICS LOOP  (4 independent wheels)";
        style="dashed"; color="#999999"; fontcolor="#777777"; fontsize=13; labeljust=l;

        aero [label="Aero forces\nf_drag, f_down from v²", fillcolor="#fdf1d6"];
        transfer [label="Weight-transfer target per axle\n(anti-squat/lift/dive, by sign of a)", fillcolor="#fdf1d6"];
        susp [label="Integrate FRONT & REAR axle\nspring/damper ODEs\n→ dynamic Fz_front, Fz_rear", fillcolor="#fdf1d6"];
        fz [label="Fz_front, Fz_rear =\nstatic + dynamic + aero (clamped ≥ 0)\nsplit evenly left/right", fillcolor="#fdf1d6"];
        slip [label="slip ratio per wheel = f(ω_wheel, v)", fillcolor="#fdf1d6"];
        tire [label="Pacejka tire model, per wheel\nf_x = tire_forces(Fz_wheel, slip)\nf_traction = sum of all 4", fillcolor="#fdf1d6"];
        rpm [label="motor_rpm per wheel from\nω_motor × final_drive_ratio", fillcolor="#fdf1d6"];
        split [label="Normalize torque_split_front\n→ front_throttle_frac, rear_throttle_frac\n(holds commanded axle ratio)", fillcolor="#fdf1d6"];
        torque [label="Motor torque curve × throttle_request\n× per-axle throttle_frac\n× per-wheel launch control cut\n(if slip > target_slip_ratio)", fillcolor="#fdf1d6"];
        plimit [label="Combined power_limit check (all 4 motors)\n→ scale every motor equally if exceeded", fillcolor="#fdf1d6"];
        shaft [label="Torque to shaft, per wheel\n(motors_per_wheel × torque × final_drive_ratio × efficiency)", fillcolor="#fdf1d6"];
        driveline [label="Two-mass torsional driveline ODE, per wheel\n(motor inertia ↔ half-shaft ↔ wheel inertia)\nall 4 independent, no diff", fillcolor="#fdf1d6"];
        rr [label="Rolling resistance f_rr\n= crr × (weight + downforce)", fillcolor="#fdf1d6"];
        accel [label="a = (f_traction − f_drag − f_rr) / car.mass\n(all 4 wheels' inertia already explicit above)", fillcolor="#fdf1d6"];
        euler [label="Semi-implicit Euler integrate:\nv, x, t, all 4 driveline states,\nboth axles' suspension states", fillcolor="#fdf1d6"];
        logstep [label="Log t, x, v, a, rpm_front, rpm_rear,\nslip_front, slip_rear, Fz_front, Fz_rear", fillcolor="#fdf1d6"];

        aero -> transfer -> susp -> fz -> slip -> tire -> rpm -> split -> torque -> plimit -> shaft -> driveline -> rr -> accel -> euler -> logstep;
    }

    decision -> aero [label="yes"];
    logstep -> decision [label="next timestep", constraint=false];

    // ---------------- OUTPUTS ----------------
    subgraph cluster_outputs {
        label="OUTPUTS";
        style="dashed"; color="#999999"; fontcolor="#777777"; fontsize=13; labeljust=l;
        result [label="elapsed_time (75 m ET)\nsim_log: full time-series\n(v, a, rpm_front/rear, slip_front/rear, Fz per axle)", fillcolor="#dcf0dc"];
        printed [label="Printed:\nElapsed Time, Trap Speed, Max Accel (g),\nMax Slip rear/front (%)", fillcolor="#dcf0dc"];
        result -> printed;
    }

    decision -> result [label="no, x ≥ 75 m"];

    // ---------------- SWEEPS ----------------
    subgraph cluster_sweeps {
        label="POST-RUN SWEEPS";
        style="dashed"; color="#999999"; fontcolor="#777777"; fontsize=13; labeljust=l;
        sweep1 [label="Sweep final_drive_ratio 10.0→15.0\n(full re-run each step)\n→ 75m time vs. ratio PNG", fillcolor="#dcf0dc"];
        sweep2 [label="Sweep torque_split_front 0.01→0.99\n→ 75m time vs. front split PNG", fillcolor="#dcf0dc"];
        sweep3 [label="Sweep target_slip_ratio 0.05→1.0\n(launch control forced on)\n→ 75m time vs. slip PNG", fillcolor="#dcf0dc"];
        sweep1 -> sweep2;
        sweep2 -> sweep3;
    }

    printed -> sweep1;
}
